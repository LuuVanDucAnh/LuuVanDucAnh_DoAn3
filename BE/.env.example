# =============================================
# Backend API Configuration
# =============================================

PORT=5000
NODE_ENV=development

# =============================================
# SQL Server Configuration
# Thay doi thong tin ket noi theo may cua ban
# =============================================
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=GiaoHangDB
DB_USER=sa
DB_PASSWORD=your_password_here

# =============================================
# JWT Configuration
# Secret key - thay doi gia tri nay trong production
# =============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars
JWT_EXPIRES_IN=7d

# =============================================
# Default Admin Password (sau khi tao tai khoan)
# =============================================
ADMIN_DEFAULT_PASSWORD=admin123
